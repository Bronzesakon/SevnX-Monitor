# Build artifacts and dependency caches. Compilation happens in CI
# (.github/workflows/build.yml), so nothing here is ever versioned.
node_modules/
target/
dist/
.vite/
.npm-cache/
.pnpm-store/
*.tsbuildinfo
/.cargo-test-target/
/.cargo-check-target/

# Local credentials, browser profile, diagnostics and environment overrides
.sevnx-profile/
.field-audit/
.env
.env.local
*.log

# Never include runtime state from the installed application.
/WebView2/
/auth/
/logs/

# Reference material kept local only: a vendored third-party project and the
# archived prototype. Neither is part of the build.
/codex-plusplus/
/RAW_MimoDesktopAssistant/
